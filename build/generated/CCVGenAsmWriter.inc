    O << " setp.ne.f ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 3, O);
    O << ", ";
    printOperand(MI, 4, O);
    return;
    break;
  case 103:
    // SETP_NE_F1
    O << " setp.ne.f1 ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 3, O);
    O << ", ";
    printOperand(MI, 4, O);
    return;
    break;
  case 104:
    // SHFL_IDX
    O << " shfl.idx ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  case 105:
    // SHLI_P, SHL_P
    O << " shl ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  case 106:
    // SHRI_P, SHR_P
    O << " shr ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  case 107:
    // SRAI_P, SRA_P
    O << " sra ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  case 108:
    // SUBI_P, SUB_P
    O << " sub ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  case 109:
    // UNBALLOT
    O << " unballot ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    return;
    break;
  case 110:
    // VOTE_ANY
    O << " vote.any ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    return;
    break;
  case 111:
    // XORI_P, XOR_P
    O << " xor ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  }


  // Fragment 2 encoded into 3 bits for 7 unique commands.
  switch ((Bits >> 22) & 7) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // PSEUDO_LD_PRED, PSEUDO_ST_PRED, LD_GLOBAL, LD_GLOBAL_W16, LD_GLOBAL_W8...
    O << " + ";
    printOperand(MI, 2, O);
    O << ']';
    return;
    break;
  case 1:
    // PSEUDO_NARROW, PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ABS, ADD, ADDI, A...
    printOperand(MI, 1, O);
    break;
  case 2:
    // PSEUDO_PADDI
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  case 3:
    // ADDI_P, ADD_P, C_ADD, C_ADDI, C_AND, C_ANDI, C_ANDN, C_FADD, C_FMAX, C...
    printOperand(MI, 2, O);
    break;
  case 4:
    // ADDI_PP, ADD_PP
    printOperand(MI, 3, O);
    O << ", ";
    printOperand(MI, 4, O);
    O << ", ";
    printOperand(MI, 1, O);
    return;
    break;
  case 5:
    // ATOM_ADD_G, ATOM_ADD_S, ATOM_AND_G, ATOM_AND_S, ATOM_EXCH_G, ATOM_EXCH...
    O << ", ";
    printOperand(MI, 2, O);
    O << ", ";
    printOperand(MI, 3, O);
    O << ", ";
    printOperand(MI, 4, O);
    break;
  case 6:
    // C_LD_GLOBAL, C_ST_GLOBAL, LD_LOCAL, LD_PRED_LOCAL, ST_LOCAL, ST_PRED_L...
    O << ']';
    return;
    break;
  }


  // Fragment 3 encoded into 2 bits for 4 unique commands.
  switch ((Bits >> 25) & 3) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // PSEUDO_NARROW, ABS, BAR_INIT, BREV, CALL, CHWIDTH_MULTI, CLZ, COS_F32,...
    return;
    break;
  case 1:
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_P, ADDI_...
    O << ", ";
    break;
  case 2:
    // ATOM_ADD_G, ATOM_ADD_S, ATOM_AND_G, ATOM_AND_S, ATOM_EXCH_G, ATOM_EXCH...
    O << "], ";
    printOperand(MI, 5, O);
    return;
    break;
  case 3:
    // LD_GLOBAL_IDX, LD_GLOBAL_IDX_W16, LD_GLOBAL_IDX_W8, LD_SHARED_IDX, ST_...
    O << ']';
    return;
    break;
  }


  // Fragment 4 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 27) & 1) {
    // ADDI_P, ADD_P, DP4_ACC, FFMA_ACC_F0, FFMA_ACC_F1, MAD_ACC, PACKI, SETP...
    printOperand(MI, 3, O);
    return;
  } else {
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_W16, ADD...
    printOperand(MI, 2, O);
  }


  // Fragment 5 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 28) & 1) {
    // DP2_BF16, DP2_F16, DP4_E4M3, DP4_E5M2, DP4_SS, FFMA_F0, FFMA_F1, MADLO
    O << ", ";
    printOperand(MI, 3, O);
    return;
  } else {
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_W16, ADD...
    return;
  }

}


/// getRegisterName - This method is automatically generated by tblgen
/// from the register set description.  This returns the assembler name
/// for the specified register.
const char *CCVInstPrinter::getRegisterName(MCRegister Reg) {
  unsigned RegNo = Reg.id();
  assert(RegNo && RegNo < 21 && "Invalid register number!");


#ifdef __GNUC__
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Woverlength-strings"
#endif
  static const char AsmStrs[] = {
  /* 0 */ "r10\0"
  /* 4 */ "p0\0"
  /* 7 */ "r0\0"
  /* 10 */ "r11\0"
  /* 14 */ "p1\0"
  /* 17 */ "r1\0"
  /* 20 */ "r12\0"
  /* 24 */ "p2\0"
  /* 27 */ "r2\0"
  /* 30 */ "r13\0"
  /* 34 */ "p3\0"
  /* 37 */ "r3\0"
  /* 40 */ "r14\0"
  /* 44 */ "r4\0"
  /* 47 */ "r15\0"
  /* 51 */ "r5\0"
  /* 54 */ "r6\0"
  /* 57 */ "r7\0"
  /* 60 */ "r8\0"
  /* 63 */ "r9\0"
};
#ifdef __GNUC__
#pragma GCC diagnostic pop
#endif

  static const uint8_t RegAsmOffset[] = {
    4, 14, 24, 34, 7, 17, 27, 37, 44, 51, 54, 57, 60, 63, 
    0, 10, 20, 30, 40, 47, 
  };

  assert (*(AsmStrs+RegAsmOffset[RegNo-1]) &&
          "Invalid alt name index for register!");
  return AsmStrs+RegAsmOffset[RegNo-1];
}

