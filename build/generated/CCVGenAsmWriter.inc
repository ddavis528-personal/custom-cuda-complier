/// printInstruction - This method is automatically generated by tablegen
/// from the instruction set description.
LLVM_NO_PROFILE_INSTRUMENT_FUNCTION
void CCVInstPrinter::printInstruction(const MCInst *MI, uint64_t Address, raw_ostream &O) {
  O << "\t";

  auto MnemonicInfo = getMnemonic(MI);

  O << MnemonicInfo.first;

  uint32_t Bits = MnemonicInfo.second;
  assert(Bits != 0 && "Cannot print this instruction.");

  // Fragment 0 encoded into 3 bits for 6 unique commands.
  switch ((Bits >> 12) & 7) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // DBG_VALUE, DBG_VALUE_LIST, DBG_INSTR_REF, DBG_PHI, DBG_LABEL, BUNDLE, ...
    return;
    break;
  case 1:
    // ADJCALLSTACKDOWN, ADJCALLSTACKUP, PSEUDO_BCAST, PSEUDO_BRA_PRED, PSEUD...
    printOperand(MI, 0, O);
    break;
  case 2:
    // PSEUDO_CAS_G, PSEUDO_CAS_S, PSEUDO_PADDI, PSEUDO_PMOV
    printOperand(MI, 2, O);
    break;
  case 3:
    // ADDI_P, ADD_P, ANDI_P, ANDNI_P, AND_P, BALLOT, CVT_D0_S0_R0_P, CVT_D0_...
    printPredQual(MI, 1, O);
    break;
  case 4:
    // ADDI_PP, ADD_PP, CAS_G, CAS_S, MOV_P, SETP_EQ, SETP_EQ_F, SETP_EQ_F1, ...
    printPredQual(MI, 2, O);
    break;
  case 5:
    // BAR_WAIT_PHASE, BRA_PRED
    printPredQual(MI, 0, O);
    break;
  }


  // Fragment 1 encoded into 7 bits for 112 unique commands.
  switch ((Bits >> 15) & 127) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // ADJCALLSTACKDOWN, ADJCALLSTACKUP, PSEUDO_CALL, PSEUDO_RET, BRA, C_BAR_...
    return;
    break;
  case 1:
    // PSEUDO_BCAST
    O << " from lane 0";
    return;
    break;
  case 2:
    // PSEUDO_BRA_PRED
    O << '(';
    printOperand(MI, 1, O);
    O << ") bra ";
    printOperand(MI, 2, O);
    return;
