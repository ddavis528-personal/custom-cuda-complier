  /* 17 */ "r1\0"
  /* 20 */ "r12\0"
  /* 24 */ "p2\0"
  /* 27 */ "r2\0"
  /* 30 */ "r13\0"
  /* 34 */ "p3\0"
  /* 37 */ "r3\0"
  /* 40 */ "r14\0"
  /* 44 */ "r4\0"
