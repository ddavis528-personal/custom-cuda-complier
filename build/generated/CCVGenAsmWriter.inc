void CCVInstPrinter::printInstruction(const MCInst *MI, uint64_t Address, raw_ostream &O) {
  O << "\t";

  auto MnemonicInfo = getMnemonic(MI);

  O << MnemonicInfo.first;

  uint32_t Bits = MnemonicInfo.second;
  assert(Bits != 0 && "Cannot print this instruction.");

  // Fragment 0 encoded into 3 bits for 6 unique commands.
  switch ((Bits >> 12) & 7) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // DBG_VALUE, DBG_VALUE_LIST, DBG_INSTR_REF, DBG_PHI, DBG_LABEL, BUNDLE, ...
    return;
    break;
  case 1:
    // ADJCALLSTACKDOWN, ADJCALLSTACKUP, PSEUDO_BCAST, PSEUDO_BRA_PRED, PSEUD...
    printOperand(MI, 0, O);
    break;
  case 2:
    // PSEUDO_PMOV
    printOperand(MI, 2, O);
    O << " mov ";
    printOperand(MI, 0, O);
    O << ", ";
    printOperand(MI, 3, O);
    return;
    break;
  case 3:
    // ADDI_P, ADD_P, ANDI_P, ANDNI_P, AND_P, BALLOT, CVT_D0_S0_R0_P, CVT_D0_...
