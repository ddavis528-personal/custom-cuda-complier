    break;
  case 1:
    // ABS, BAR_INIT, BREV, CALL, CHWIDTH_MULTI, CLZ, COS_F32, CVT_F32_S32, C...
    return;
    break;
  case 2:
    // ATOM_ADD_G
    printOperand(MI, 3, O);
    O << "], ";
    printOperand(MI, 2, O);
    return;
    break;
  case 3:
    // LD_GLOBAL, LD_GLOBAL_W16, LD_GLOBAL_W8, LD_PRED_G, LD_PRED_S, LD_SHARE...
    printOperand(MI, 2, O);
    O << ']';
    return;
    break;
  }


  // Fragment 4 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 25) & 1) {
    // ADDI_P, ADD_P, DP4_ACC, FFMA_ACC_F0, FFMA_ACC_F1, MAD_ACC, PACKI, SETP...
    printOperand(MI, 3, O);
    return;
  } else {
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_W16, ADD...
    printOperand(MI, 2, O);
  }


  // Fragment 5 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 26) & 1) {
    // DP2_BF16, DP2_F16, DP4_E4M3, DP4_E5M2, DP4_SS, FFMA_F0, MADLO
    O << ", ";
    printOperand(MI, 3, O);
    return;
  } else {
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_W16, ADD...
    return;
  }

}


