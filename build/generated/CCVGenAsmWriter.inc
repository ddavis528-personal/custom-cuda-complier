    O << ", ";
    printOperand(MI, 4, O);
    O << ']';
    return;
    break;
  }


  // Fragment 3 encoded into 2 bits for 4 unique commands.
  switch ((Bits >> 23) & 3) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // PSEUDO_LD_PRED, PSEUDO_ST_PRED, LD_GLOBAL, LD_GLOBAL_W16, LD_GLOBAL_W8...
    printOperand(MI, 2, O);
    O << ']';
    return;
    break;
  case 1:
    // PSEUDO_NARROW, ABS, BAR_INIT, BREV, CALL, CHWIDTH_MULTI, CLZ, COS_F32,...
    return;
    break;
  case 2:
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_P, ADDI_...
    O << ", ";
    break;
  case 3:
    // ATOM_ADD_G
    printOperand(MI, 3, O);
    O << "], ";
    printOperand(MI, 2, O);
    return;
    break;
  }


  // Fragment 4 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 25) & 1) {
    // ADDI_P, ADD_P, DP4_ACC, FFMA_ACC_F0, FFMA_ACC_F1, MAD_ACC, PACKI, SETP...
    printOperand(MI, 3, O);
    return;
  } else {
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_W16, ADD...
    printOperand(MI, 2, O);
  }


  // Fragment 5 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 26) & 1) {
    // DP2_BF16, DP2_F16, DP4_E4M3, DP4_E5M2, DP4_SS, FFMA_F0, MADLO
    O << ", ";
    printOperand(MI, 3, O);
    return;
  } else {
    // PSEUDO_PAND, PSEUDO_POR, PSEUDO_PXOR, ADD, ADDI, ADDI48, ADDI_W16, ADD...
    return;
  }

}


