build/
*.o
*.ll
*.bc
*.s
.cache/
compile_commands.json
/build/

# ...but the test suite is source, not build output. Every .ll under test/ is a
# hand-written regression case, and they were all silently untracked: a fresh
# clone had three .cu files and no accept/reject suite at all.
!test/**
vendor/

# Python bytecode. It was tracked by accident, and every run of a Python tool
# dirtied the tree with it.
__pycache__/
